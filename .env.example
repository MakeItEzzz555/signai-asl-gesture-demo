# Google Cloud Text-to-Speech API key
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable the "Cloud Text-to-Speech API" for your project first.
#
# Set this value in your deployment environment — NEVER commit the real key:
#   Vercel:  Project Settings → Environment Variables
#   Netlify: Site Settings → Environment variables
#   Local:   copy this file to .env.local and fill in the key
#
# With no key set, the app silently falls back to local Piper/eSpeak voices.
GOOGLE_TTS_API_KEY=
